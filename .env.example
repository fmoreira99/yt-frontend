# --- Acceso al frontend ---
# Contraseña única para entrar a la app (obligatoria en producción).
APP_PASSWORD=
# Opcional: clave para firmar la cookie de sesión (por defecto se deriva de APP_PASSWORD).
# Generar con: openssl rand -hex 32
SESSION_SECRET=

# --- URLs de los microservicios (valores por defecto = los desplegados) ---
EXTRACTOR_URL=https://yt-extractor-service.onrender.com
CORE_DB_URL=https://core-db-service.onrender.com
MEDIA_HUB_URL=https://ptbiuplgwmjwvzwpogep.supabase.co/functions/v1/media-hub
# URL de ms-youtube (sin default: indícala cuando esté desplegado)
MS_YOUTUBE_URL=

# --- Secretos (solo servidor; nunca llegan al navegador) ---
# Misma clave INTERNAL_API_KEY que usan yt-extractor-service y core-db-service (header x-service-api-key)
INTERNAL_API_KEY=
# Una de las claves de MEDIA_HUB_API_KEYS del gateway (Authorization: Bearer)
MEDIA_HUB_API_KEY=
# Mismo JWT_SECRET que ms-youtube (el servidor firma un JWT corto por petición)
YOUTUBE_JWT_SECRET=
